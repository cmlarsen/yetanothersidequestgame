{
  "name": "yas-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch main.ts",
    "start": "tsx main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:purity": "tsx tools/check-sim-purity.ts",
    "ci:fast": "npm run lint:purity && npm run typecheck && npm run test",
    "golden:generate": "tsx test/golden/generate.ts",
    "deploy": "npm run ci:fast && flyctl deploy"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.30",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
