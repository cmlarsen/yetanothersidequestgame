; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="SideQuest"
config/features=PackedStringArray("4.6", "Mobile")
run/main_scene="res://scenes/app.tscn"

[autoload]

GameState="*res://src/data/game_state.gd"
Router="*res://src/app/router.gd"
NetClient="*res://src/net/net_client.gd"

[display]

window/size/viewport_width=402
window/size/viewport_height=874
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
